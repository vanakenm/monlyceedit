{
  "name": "monlyceedit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run data:csv",
    "build": "tsc -b && vite build",
    "prebuild": "npm run data:csv",
    "lint": "oxlint",
    "preview": "vite preview",
    "data:lycees": "node scripts/fetch-lycees.mjs",
    "data:personnes": "node scripts/fetch-personnalites.mjs && npm run data:citations",
    "data:citations": "node scripts/citations-manuelles.mjs",
    "data": "npm run data:lycees && npm run data:personnes",
    "data:csv": "node scripts/export-csv.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
